generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Global Enums ────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  DEPT_MANAGER
  DEPT_MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  medium
  high
}

// ─── Notification Enum ───────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  MENTIONED_IN_COMMENT
  TASK_UPDATED
  DEADLINE_SOON
  DEADLINE_3_DAYS
  DEADLINE_2_DAYS
  DEADLINE_1_DAY
  DEADLINE_12_HOURS
  DEADLINE_4_HOURS
  DEADLINE_1_HOUR
  DEPT_MEMBER_JOINED
  NOTE_ADDED
  PROJECT_MEMBER_JOINED
  MILESTONE_COMPLETED
}

// ─── V4: Milestone Enum ──────────────────────────────────────

enum MilestoneStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Recurrence Enum ─────────────────────────────────────────

enum RecurrenceType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ─── Department/RBAC Enums ───────────────────────────────────

enum DepartmentMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

// ─── Models ──────────────────────────────────────────────────

model Profile {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  avatar       String?
  supabaseId   String?    @unique
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  mongoId      String?    @unique
  username     String?    @unique
  jobTitle     String?    @db.VarChar(200)
  tasks                Task[]
  todos                Todo[]
  memberships          DepartmentMember[]    @relation("MemberProfile")
  invitedMemberships   DepartmentMember[]    @relation("InviterProfile")
  sentInvitations      DepartmentInvitation[] @relation("InviterInvitation")
  comments             Comment[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  timeSessions         TimeTrackingSession[]
  ownedProjects        Project[]             @relation("ProjectOwner")
  projectMembers       ProjectMember[]
  taskNotes            TaskNote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("profiles")
}

model Department {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  memberships  DepartmentMember[]
  invitations  DepartmentInvitation[]
  activityLogs ActivityLog[]
  projects     ProjectDepartment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("departments")
}

model DepartmentMember {
  id           String               @id @default(uuid())
  userId       String
  departmentId String
  role         DepartmentMemberRole @default(MEMBER)
  status       MembershipStatus     @default(ACTIVE)
  joinedAt     DateTime             @default(now())
  invitedBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  member       Profile              @relation("MemberProfile", fields: [userId], references: [id], onDelete: Cascade)
  inviter      Profile?             @relation("InviterProfile", fields: [invitedBy], references: [id], onDelete: SetNull)
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
  @@index([status])
  @@map("department_members")
}

model DepartmentInvitation {
  id           String               @id @default(uuid())
  departmentId String
  email        String
  role         DepartmentMemberRole @default(MEMBER)
  token        String               @unique
  invitedBy    String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime             @default(now())

  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  inviter      Profile              @relation("InviterInvitation", fields: [invitedBy], references: [id])

  @@index([departmentId, email])
  @@index([token])
  @@index([email])
  @@map("department_invitations")
}

model ActivityLog {
  id           String    @id @default(uuid())
  actorUserId  String?
  departmentId String?
  entityType   String
  entityId     String?
  action       String
  metadata     Json?
  createdAt    DateTime  @default(now())

  actor        Profile?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([departmentId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Task {
  id                  String          @id @default(uuid())
  title               String
  description         String          @default("")
  status              TaskStatus      @default(todo)
  priority            TaskPriority    @default(medium)
  tags                String[]
  deadline            DateTime?
  mongoId             String?         @unique
  profileId           String
  profile             Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  columnId            String?
  column              BoardColumn?    @relation(fields: [columnId], references: [id], onDelete: SetNull)
  comments            Comment[]
  notes               TaskNote[]
  timeSessions        TimeTrackingSession[]
  completedAt         DateTime?
  assignedTo          String?
  assignedBy          String?
  isRecurring         Boolean         @default(false)
  recurrenceType      RecurrenceType?
  recurrenceInterval  Int?
  recurrenceEndDate   DateTime?
  recurrenceParentId  String?
  scheduledAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // ── V4: Milestone & Subtask fields (Phase 2) ─────────────
  milestoneId    String?
  milestone      Milestone?  @relation("MilestoneTasks", fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneOrder Int?
  parentTaskId   String?
  parent         Task?       @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]      @relation("TaskSubtasks")
  inProgressAt   DateTime?
  estimatedHours Float?

  @@index([profileId])
  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([deadline])
  @@index([scheduledAt])
  @@index([profileId, scheduledAt])
  @@index([profileId, status])
  @@index([profileId, completedAt])
  @@index([completedAt])
  @@index([recurrenceParentId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([columnId])
  @@index([milestoneId])
  @@index([milestoneId, milestoneOrder])
  @@index([parentTaskId])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([taskId, parentId])
  @@index([authorId])
  @@index([createdAt])
  @@map("comments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  payload    Json?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Todo {
  id        String   @id @default(uuid())
  profileId String
  text      String   @db.VarChar(500)
  done      Boolean  @default(false)
  tags      String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, done])
  @@index([createdAt])
  @@map("todos")
}

model TimeTrackingSession {
  id              String    @id @default(uuid())
  taskId          String
  profileId       String
  startedAt       DateTime
  stoppedAt       DateTime?
  durationSeconds Int?

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([taskId])
  @@index([profileId, startedAt])
  @@index([profileId, stoppedAt])
  @@map("time_tracking_sessions")
}

// ─── V3: Project Models ──────────────────────────────────────

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  ownerId     String
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       Profile             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  departments ProjectDepartment[]
  members     ProjectMember[]
  tasks       Task[]
  columns     BoardColumn[]
  milestones  Milestone[]
  slackConfig ProjectSlackConfig?

  @@index([ownerId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectDepartment {
  id           String     @id @default(uuid())
  projectId    String
  departmentId String
  createdAt    DateTime   @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, departmentId])
  @@index([projectId])
  @@index([departmentId])
  @@map("project_departments")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  profileId String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([projectId])
  @@index([profileId])
  @@map("project_members")
}

// ─── V4: Milestone Model ─────────────────────────────────────

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String?
  startDate   DateTime?
  deadline    DateTime?
  status      MilestoneStatus @default(ACTIVE)
  order       Int             @default(0)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]  @relation("MilestoneTasks")

  @@index([projectId])
  @@index([projectId, order])
  @@index([status])
  @@map("milestones")
}

// ─── V3: Phase 3 Models ──────────────────────────────────────

model BoardColumn {
  id        String   @id @default(uuid())
  projectId String?
  name      String
  color     String   @default("#94a3b8")
  order     Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([projectId, order])
  @@map("board_columns")
}

// ─── V3: Phase 2 Models ──────────────────────────────────────

model TaskNote {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([taskId, order])
  @@map("task_notes")
}

// ─── V3: Phase 5 Models ──────────────────────────────────────

model ProjectSlackConfig {
  id                String  @id @default(cuid())
  projectId         String  @unique
  webhookUrl        String
  dailyEnabled      Boolean @default(true)
  weeklyEnabled     Boolean @default(true)
  managerWebhookUrl String?
  memberWebhookUrl  String? // stored; reserved for Phase 8 task/member notifications
  dailyTime         String  @default("18:00")
  weeklyDay         Int     @default(5)
  weeklyTime        String  @default("17:00")
  timezone          String  @default("UTC")
  lastDailySentKey  String? // idempotency key e.g. "2026-06-03" — set before send
  lastWeeklySentKey String? // idempotency key e.g. "2026-W23"   — set before send
  webhookSecret     String? @unique // Phase 8: n8n inbound webhook authentication
  emojiMappings     Json?   // Phase 8: { "sunglasses": "profileId" } — canonical emoji names

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_slack_configs")
}
